{
  "name": "@skew-mmr/core",
  "version": "0.4.0",
  "description": "Reference TypeScript implementation of the skew-MMR accumulator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robert-MacWha/efficient-inclusion-proofs.git",
    "directory": "packages"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mmr": {
      "types": "./dist/mmr.d.ts",
      "default": "./dist/mmr.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "default": "./dist/proof.js"
    },
    "./hasher": {
      "types": "./dist/hasher.d.ts",
      "default": "./dist/hasher.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "constraints": "circom test/circuits/inclusion_full.circom --r1cs --O2 -l node_modules -o $(mktemp -d)",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "bench": "node bench/perf.ts"
  },
  "dependencies": {
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "@zk-kit/imt": "2.0.0-beta.8",
    "@zk-kit/lean-imt": "2.2.5",
    "circom_tester": "^0.0.20",
    "circomlib": "^2.0.5",
    "tinybench": "2.9.0",
    "typescript": "^5.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
